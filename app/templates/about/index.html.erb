<section class="hero">
  <div class="wrapper flow">
    <h1><%= t(".hero.title") %></h1>
    <p><%= t(".hero.text") %></p>
  </div>
</section>

<section>
  <div class="wrapper">
    <ul role="list" class="flow">
      <% %w[mick wout].each_with_index do |id, index| %>
        <%= scope(:person, id: id, index: index).render("about/person") %>
      <% end %>
    </ul>
  </div>
</section>

<article class="centered">
  <div class="prose flow">
    <h2><%= t(".story.title") %></h2>
    <%= raw markdown(t(".story.text")) %>
  </div>
</article>
