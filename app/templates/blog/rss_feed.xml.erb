<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/">
  <channel>
    <title>Fluck Blog</title>
    <link><%= absolute_url(routes.path(:blog)) %></link>
    <atom:link href="<%= absolute_url(routes.path(:blog_rss)) %>" rel="self" type="application/rss+xml" />
    <description>Updates, progress, new features, and general news from Fluck.</description>
    <language>en</language>
    <% posts.each do |post| %>
      <item>
        <title><%= h post.title %></title>
        <link><%= absolute_url(routes.path(:blog_post, slug: post.slug)) %></link>
        <guid isPermaLink="true"><%= absolute_url(routes.path(:blog_post, slug: post.slug)) %></guid>
        <pubDate><%= post.rfc822_date %></pubDate>
        <description><%= h post.description %></description>
        <content:encoded><![CDATA[<%= post.to_html %>]]></content:encoded>
      </item>
    <% end %>
  </channel>
</rss>
