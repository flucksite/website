<!DOCTYPE html>
<html lang="<%= ::I18n.locale %>">
  <%= render "shared/layout_head" %>
  <body
    data-bg="<%= page_key %>"
    x-data="theme(<%= current_theme_arg %>)"
    :data-theme="theme"
  >
    <%= link_to t("global.buttons.skip_link"), "#main_content", id: "skip_link" %>
    <%= inline_svg("clip-path-shapes-03", class: "visually-hidden", aria_hidden: "true") %>
    <%= render "shared/header" %>
    <main id="main_content" tabindex="-1">
      <%= yield %>
    </main>
    <%= scope(:footer).render("shared/footer") %>
  </body>
</html>
